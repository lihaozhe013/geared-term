{
  "name": "geared-term",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A secure Electron terminal application.",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @geared-term/desktop dev",
    "build": "pnpm --filter @geared-term/desktop build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "pnpm build && pnpm --filter @geared-term/desktop test:e2e",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "package": "pnpm --filter @geared-term/desktop package",
    "package:win": "pnpm --filter @geared-term/desktop package:win",
    "package:mac": "pnpm --filter @geared-term/desktop package:mac",
    "package:linux": "pnpm --filter @geared-term/desktop package:linux"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "prettier": "3.9.8",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
